# ============ APP ============
API_KEY=change-me-to-a-long-random-string      # extension sends this in X-API-Key header

# ============ FREE LLM PROVIDER (OpenAI-compatible) ============
# Default = Groq free tier. Get a free key at https://console.groq.com/keys
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=paste-your-groq-key-here
SMALL_MODEL=llama-3.1-8b-instant               # cheap/fast model for simple questions
LARGE_MODEL=llama-3.3-70b-versatile            # strong model for complex questions

# ---- Other FREE options (just change the 4 lines above) ----
# Ollama (100% local):  LLM_BASE_URL=http://localhost:11434/v1  LLM_API_KEY=ollama
#                       SMALL_MODEL=llama3.2:3b  LARGE_MODEL=llama3.1:8b
# Gemini free tier:     LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# OpenRouter ":free":   LLM_BASE_URL=https://openrouter.ai/api/v1

